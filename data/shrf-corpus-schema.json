{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "shrf-corpus-schema-v1",
  "title": "SHRF Corpus Schema",
  "description": "Validation schema for shrf-corpus-v*.json. Every corpus file must pass this before being used as renderer input.",
  "type": "object",
  "required": ["_meta", "nodes", "edges", "gaps", "overlaps"],

  "properties": {
    "_meta": {
      "type": "object",
      "required": ["schema", "source", "canonical_doi", "renderer_rule", "last_updated", "version"],
      "properties": {
        "schema":        { "type": "string" },
        "source":        { "type": "string" },
        "canonical_doi": { "type": "string", "pattern": "^10\\.\\d{4,}/zenodo\\.\\d+$" },
        "renderer_rule": { "type": "string" },
        "last_updated":  { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "version":       { "type": "string" }
      }
    },

    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "doi", "title", "short", "tier", "layer", "branch", "state", "confidence", "status", "baseline12", "angle_hint", "radius_hint", "description", "open_gaps", "falsifiers"],
        "properties": {
          "id":           { "type": "string", "minLength": 1 },
          "doi":          { "type": "string", "pattern": "^10\\.\\d{4,}/zenodo\\.\\d+$" },
          "title":        { "type": "string", "minLength": 1 },
          "short":        { "type": "string", "maxLength": 16 },
          "tier":         { "type": "string", "enum": ["T0", "T1", "T2", "T3"] },
          "layer":        { "type": "string", "enum": ["METHOD", "FRAMEWORK", "FOUNDATION", "BRANCH", "NOTE", "CASE"] },
          "branch":       { "type": "string", "minLength": 1 },
          "state":        { "type": "string", "enum": ["VERIFIED", "INFERRED", "SPECULATIVE", "ANALOGICAL", "WITHDRAWN", "UNKNOWN"] },
          "confidence":   { "type": "string", "enum": ["CANONICAL", "DERIVED-CANONICAL", "USER-CONFIRMED", "INFERRED", "NEEDS-REVIEW"] },
          "status":       { "type": "string" },
          "baseline12":   { "type": "boolean" },
          "baseline12_node": { "type": "integer", "minimum": 1 },
          "baseline12_pending": { "type": "boolean" },
          "angle_hint":   { "type": "number", "minimum": 0, "maximum": 360 },
          "radius_hint":  { "type": "number", "minimum": 0.0, "maximum": 1.0 },
          "description":  { "type": "string" },
          "open_gaps":    { "type": "array", "items": { "type": "string" } },
          "falsifiers":   { "type": "array", "items": { "type": "string" } },
          "preferred_cite":  { "type": "boolean" },
          "version_of":      { "type": "string", "pattern": "^10\\.\\d{4,}/zenodo\\.\\d+$" },
          "trident_gate":    { "type": "string" },
          "surviving_condition": { "type": "object" }
        },
        "if": { "properties": { "baseline12": { "const": true } } },
        "then": { "required": ["baseline12_node"] }
      }
    },

    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "target", "type", "strength", "confidence"],
        "properties": {
          "source":     { "type": "string" },
          "target":     { "type": "string" },
          "type":       { "type": "string", "enum": [
            "IsFoundationFor", "IsContinuedBy", "IsAppliedIn",
            "IsAdjacentTo", "References", "IsVersionOf", "IsPartOf",
            "IsCitedBy", "Cites"
          ]},
          "strength":   { "type": "number", "minimum": 0.0, "maximum": 1.0 },
          "confidence": { "type": "string", "enum": ["CANONICAL", "DERIVED-CANONICAL", "USER-CONFIRMED", "INFERRED", "NEEDS-REVIEW"] }
        }
      }
    },

    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "node", "description", "severity", "type"],
        "properties": {
          "id":          { "type": "string", "pattern": "^GAP-" },
          "node":        { "type": "string" },
          "description": { "type": "string" },
          "severity":    { "type": "string", "enum": ["high", "medium", "low"] },
          "type":        { "type": "string", "enum": ["observational", "empirical", "theoretical", "annotation", "metadata"] }
        }
      }
    },

    "overlaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "nodes", "description", "type"],
        "properties": {
          "id":          { "type": "string", "pattern": "^OVL-" },
          "nodes":       { "type": "array", "minItems": 2, "items": { "type": "string" } },
          "description": { "type": "string" },
          "type":        { "type": "string", "enum": [
            "domain-overlap", "framework-overlap", "branch-continuity",
            "spine-continuity", "conceptual-overlap", "evidence-overlap"
          ]}
        }
      }
    }
  },

  "_validation_rules": {
    "note": "The following cross-reference rules cannot be expressed in JSON Schema and must be checked programmatically by the validator.",
    "rules": [
      "Every edge.source must match a node.id",
      "Every edge.target must match a node.id",
      "Every gap.node must match a node.id",
      "Every overlap.nodes[] entry must match a node.id",
      "No duplicate node.id values",
      "No duplicate node.doi values",
      "If node.preferred_cite is true, node.version_of must be present",
      "If node.baseline12 is true, node.baseline12_node must be present and unique",
      "If node.version_of is present, a node with that doi should exist in the corpus (or be flagged as external)"
    ]
  }
}
